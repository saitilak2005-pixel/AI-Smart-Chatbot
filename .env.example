# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Choose your provider: groq | openai
LLM_PROVIDER=groq

# ─── API Key (REQUIRED) ────────────────────────────────────────────────────────
# Get a free Groq key at: https://console.groq.com
# Get an OpenAI key at:   https://platform.openai.com/api-keys
LLM_API_KEY=your_api_key_here

# ─── Model Selection ──────────────────────────────────────────────────────────
# Groq models:   llama-3.1-8b-instant | llama-3.1-70b-versatile | mixtral-8x7b-32768
# OpenAI models: gpt-4o-mini | gpt-4o | gpt-3.5-turbo
LLM_MODEL=llama-3.1-8b-instant

# ─── Generation Parameters ────────────────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ─── Advanced (Optional) ──────────────────────────────────────────────────────
# Override the API base URL (for custom OpenAI-compatible endpoints)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Request timeout in seconds
LLM_TIMEOUT=30

# Number of retries on transient failures
LLM_MAX_RETRIES=2
